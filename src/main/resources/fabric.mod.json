{
	"schemaVersion": 1,
	"id": "larpcraft",
	"version": "${version}",
	"name": "LARPCRAFT",
	"description": "Larp as anime characters with unique passives, skills and ultimates. Use /larp <name> to pick a character and /unlarp to stop.",
	"authors": [
		"leaffoil"
	],
	"contact": {
		"homepage": "https://github.com/leaffoil/LARPCRAFT",
		"sources": "https://github.com/leaffoil/LARPCRAFT"
	},
	"license": "CC0-1.0",
	"icon": "assets/larpcraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.larpcraft.larp.LARPCRAFT"
		],
		"client": [
			"com.larpcraft.larp.client.LARPCRAFTClient"
		]
	},
	"mixins": [
		"larpcraft.mixins.json",
		{
			"config": "larpcraft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}